#!/bin/sh /etc/rc.common
START=90
STOP=10

IFACE="wlan0"
CONF="/etc/wpa_supplicant.conf"
PID="/var/run/wpa_supplicant_waybeam.pid"

start() {
	# Bring up the radio
	ip link set "$IFACE" up 2>/dev/null || {
		# wlan0 might not exist yet, create it from phy0
		iw phy phy0 interface add "$IFACE" type managed 2>/dev/null
		ip link set "$IFACE" up
	}

	# Start wpa_supplicant with our multi-network config
	wpa_supplicant -B -i "$IFACE" -c "$CONF" -P "$PID"

	# Wait for association then request DHCP
	( sleep 10; udhcpc -i "$IFACE" -b -q -t 5 -p /var/run/udhcpc_waybeam.pid ) &
}

stop() {
	[ -f "$PID" ] && kill "$(cat $PID)" 2>/dev/null
	[ -f /var/run/udhcpc_waybeam.pid ] && kill "$(cat /var/run/udhcpc_waybeam.pid)" 2>/dev/null
	ip link set "$IFACE" down 2>/dev/null
	rm -f "$PID" /var/run/udhcpc_waybeam.pid
}
