#!/bin/sh
# Append waybeam-02 through waybeam-08 to wpa_supplicant config
# Triggered when phy0-sta0 interface appears

[ "$ACTION" = "add" ] || exit 0
[ "$INTERFACE" = "phy0-sta0" ] || exit 0

CONF="/tmp/run/wpa-supplicant-phy0-sta0.conf"
[ -f "$CONF" ] || exit 0

# Only add once (check if already appended)
grep -q "waybeam-02" "$CONF" && exit 0

for i in 02 03 04 05 06 07 08; do
    cat >> "$CONF" << EOF
network={
	ssid="waybeam-${i}"
	scan_ssid=1
	key_mgmt=WPA-PSK
	psk="waybeam-${i}"
	proto=RSN
}
EOF
done

# OpenIPC default network
cat >> "$CONF" << EOF
network={
	ssid="OpenIPC"
	scan_ssid=1
	key_mgmt=WPA-PSK
	psk="12345678"
	proto=RSN
}
EOF

# Also add open network variants (in case APs have no encryption)
for i in 01 02 03 04 05 06 07 08; do
    cat >> "$CONF" << EOF
network={
	ssid="waybeam-${i}"
	scan_ssid=1
	key_mgmt=NONE
}
EOF
done

# Tell wpa_supplicant to reload
kill -HUP $(pgrep wpa_supplicant) 2>/dev/null
