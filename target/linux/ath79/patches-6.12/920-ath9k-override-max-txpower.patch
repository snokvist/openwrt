ath9k: override EEPROM TX power limits for research

Bypass three power capping layers in the ath9k driver:
1. channel->max_power (cfg80211/EEPROM channel limit)
2. CTL edge power (EEPROM conformance test limits)
3. scaledPower (regulatory/antenna reduction)

For research purposes only.

--- a/drivers/net/wireless/ath/ath9k/hw.c
+++ b/drivers/net/wireless/ath/ath9k/hw.c
@@ -2964,7 +2964,8 @@
 		ctl = ath9k_regd_get_ctl(reg, chan);

 	channel = chan->chan;
-	chan_pwr = min_t(int, channel->max_power * 2, MAX_COMBINED_POWER);
+	/* Research override: bypass EEPROM max_power cap */
+	chan_pwr = MAX_COMBINED_POWER;
 	new_pwr = min_t(int, chan_pwr, reg->power_limit);

 	ah->eep_ops->set_txpower(ah, chan, ctl,
--- a/drivers/net/wireless/ath/ath9k/ar9003_eeprom.c
+++ b/drivers/net/wireless/ath/ath9k/ar9003_eeprom.c
@@ -5250,8 +5250,8 @@
 	bool is2ghz = IS_CHAN_2GHZ(chan);

 	ath9k_hw_get_channel_centers(ah, chan, &centers);
-	scaledPower = ath9k_hw_get_scaled_power(ah, powerLimit,
-						antenna_reduction);
+	/* Research override: skip antenna reduction */
+	scaledPower = min_t(u16, powerLimit, MAX_RATE_POWER);

 	if (is2ghz) {
 		/* Setup for CTL modes */
@@ -5347,7 +5347,8 @@
 			}
 		}

-		minCtlPower = (u8)min(twiceMaxEdgePower, scaledPower);
+		/* Research override: bypass CTL edge power */
+		minCtlPower = scaledPower;

 		ath_dbg(common, REGULATORY,
 			"SEL-Min ctlMode %d pCtlMode %d 2xMaxEdge %d sP %d minCtlPwr %d\n",
