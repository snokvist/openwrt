 	CHAN5G(5680, 31), /* Channel 136 */
 	CHAN5G(5700, 32), /* Channel 140 */
+	CHAN5G(5720, 33), /* Channel 144 */
 	/* _We_ call this UNII 3 */
-	CHAN5G(5745, 33), /* Channel 149 */
-	CHAN5G(5765, 34), /* Channel 153 */
-	CHAN5G(5785, 35), /* Channel 157 */
-	CHAN5G(5805, 36), /* Channel 161 */
-	CHAN5G(5825, 37), /* Channel 165 */
+	CHAN5G(5745, 34), /* Channel 149 */
+	CHAN5G(5765, 35), /* Channel 153 */
+	CHAN5G(5785, 36), /* Channel 157 */
+	CHAN5G(5805, 37), /* Channel 161 */
+	CHAN5G(5825, 38), /* Channel 165 */
+	/* Extended UNII 3+ / UNII 4 - research */
+	CHAN5G(5845, 39), /* Channel 169 */
+	CHAN5G(5865, 40), /* Channel 173 */
+	CHAN5G(5885, 41), /* Channel 177 */
+	CHAN5G(5905, 42), /* Channel 181 */
 };

